---
title: "Análisis exploratorio del consumo de recursos en Google Cluster Data 2019"
uso <- arrow::read_parquet(
"data/processed/uso_procesado.parquet"
)
sub <- uso |>
dplyr::select(cpu_prom, mem_prom) |>
dplyr::filter(!is.na(cpu_prom), !is.na(mem_prom))
set.seed(2019)
if (nrow(sub) > 100000) {
sub <- dplyr::slice_sample(sub, n = 100000)
}
prueba <- suppressWarnings(
stats::cor.test(
sub$cpu_prom,
sub$mem_prom,
method = "spearman"
)
)
class(prueba)
str(prueba)
source("main.R")
source("main.R")
traceback()
traceback()
source("main.R")
source("main.R")
